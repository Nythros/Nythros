# 自动检测文本文件（推荐保留这一行）
* text=auto

# 明确声明以下后缀为文本文件，提交时统一转为 LF
*.php     text eol=lf
*.json    text eol=lf
*.lock    text eol=lf
*.neon    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf

# 测试目录下的所有文件也按文本处理
tests/**  text eol=lf

# 二进制文件（禁止换行符转换和 Diff）
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.zip     binary
*.tar.gz  binary